# Copy this file to .env.local and fill in your values.

ADMIN_PASSWORD=change-me-before-using
ENCRYPTION_KEY=replace-with-a-long-random-secret-string

EMAIL_DOMAIN=yourdomain.com
NEXT_PUBLIC_EMAIL_DOMAIN=yourdomain.com

CPANEL_HOST=yourdomain.com
CPANEL_PORT=2083
CPANEL_USERNAME=your_cpanel_username
CPANEL_PASSWORD=your_cpanel_password
CPANEL_INSECURE=false

# IMAP_HOST=mail.yourdomain.com   # defaults to mail.{EMAIL_DOMAIN}
IMAP_PORT=993
IMAP_REJECT_UNAUTHORIZED=true
